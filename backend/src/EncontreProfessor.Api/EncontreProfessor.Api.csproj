<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EncontreProfessor.Dominio\EncontreProfessor.Dominio.csproj" />
  </ItemGroup>

  <!-- Usa o professores.json da raiz do repositório (fonte única), copiando-o para a saída. -->
  <ItemGroup>
    <Content Include="..\..\..\professores.json" Link="professores.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
